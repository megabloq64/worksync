{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Orleans": "Warning",
      "Polly": "Warning",
      "GarnetServer": "Warning",
      "ArgParser": "Warning",
      "Options": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "WorkSync": {
    "Profile": "Development",
    "ClusterId": "worksync-dev",
    "ServiceId": "worksync",
    "Silo": {
      "SiloPort": 11111,
      "GatewayPort": 30000,
      "IsTrainer": true
    },
    "EventStore": {
      "Kind": "Garnet",
      "Embedded": true,
      "EmbeddedPort": 6380
    },
    "Registry": {
      "Kind": "LocalFolder"
    },
    "Seed": {
      "Records": 4000,
      "Days": 30
    },
    "Grains": {
      "RetrainAfterNewRecords": 1000,
      "RetrainInterval": "06:00:00",
      "SimulationTimeCompression": 3600
    }
  }
}
